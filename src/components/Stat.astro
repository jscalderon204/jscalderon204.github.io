---
import SourceTag from './SourceTag.astro';

/* A measured number as a specimen: large mono tabular readout + label +
   provenance. `accent="amber"` is reserved strictly for human-stakes
   punchline deltas (e.g. the +0.336 jump, "beats the locals"). */
interface Props {
  value: string;          // the figure, already formatted (e.g. "0.724", "83.6")
  unit?: string;          // small trailing unit (e.g. "%", "params")
  prefix?: string;        // small leading mark (e.g. "+", "×")
  label: string;
  source?: string;
  accent?: 'cobalt' | 'amber' | 'none';
  size?: 'md' | 'lg';
  /** Count the number up from 0 to its real value on scroll-into-view. Only for
      clean numeric `value`s; the final frame is the exact source string. */
  countup?: boolean;
}
const {
  value, unit, prefix, label, source,
  accent = 'cobalt', size = 'md', countup = false,
} = Astro.props;

// Count-up metadata, derived from the already-formatted value so the animation
// lands on the identical string (measured-truth: nothing rounded away).
const cnum = countup ? parseFloat(value.replace(/[^0-9.-]/g, '')) : NaN;
const decimals = countup ? (value.split('.')[1]?.length ?? 0) : 0;
const grouped = countup && value.includes(',');
const doCount = countup && Number.isFinite(cnum);
---

<div class:list={['stat', `stat--${accent}`, `stat--${size}`, { reveal: doCount }]}>
  <div class="stat__value mono tnum">
    {prefix && <span class="stat__prefix">{prefix}</span>}
    {doCount ? (
      <span
        class="stat__num"
        data-countup={cnum}
        data-countup-decimals={decimals}
        data-countup-group={grouped ? 'true' : undefined}
      >{value}</span>
    ) : (
      <span class="stat__num">{value}</span>
    )}
    {unit && <span class="stat__unit">{unit}</span>}
  </div>
  <div class="stat__label">{label}</div>
  {source && <SourceTag source={source} />}
</div>

<style>
  .stat { display: grid; gap: 0.45rem; align-content: start; }
  .stat__value {
    line-height: 0.95;
    letter-spacing: -0.02em;
    font-weight: 600;
    color: var(--ink-strong);
    display: flex;
    align-items: baseline;
    gap: 0.15em;
  }
  .stat--md .stat__value { font-size: var(--step-4); }
  .stat--lg .stat__value { font-size: var(--step-6); font-weight: 650; }
  .stat--cobalt .stat__num { color: var(--cobalt-ink); }
  .stat--amber .stat__num { color: var(--amber-ink); }
  .stat__prefix { font-size: 0.6em; color: var(--muted); font-weight: 500; }
  .stat__unit { font-size: 0.42em; color: var(--muted); font-weight: 500; letter-spacing: 0; }
  .stat__label {
    font-size: var(--step--1);
    color: var(--ink);
    max-width: 30ch;
    line-height: 1.4;
  }
  .stat--lg .stat__label { font-size: var(--step-0); }
</style>
