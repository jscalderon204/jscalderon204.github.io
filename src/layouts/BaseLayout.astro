---
import '../styles/global.css';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import { site } from '../data/site';

interface Props {
  title?: string;
  description?: string;
  /** Hide the global nav (e.g. for the immersive Sea Ice header), defaults to shown. */
  wide?: boolean;
}

const { title, description = site.description, wide = false } = Astro.props;
const fullTitle = title ? `${title} · ${site.name}` : `${site.name} · ${site.role}`;
const canonical = new URL(Astro.url.pathname, Astro.site).href;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta name="color-scheme" content="light" />

    <!-- Motion gate: enable progressive-enhancement motion before first paint,
         but only when the visitor has not asked to reduce motion. Without this
         class, every pre-animation state in global.css is simply absent, so the
         no-JS / reduced-motion render is the final, visible content. -->
    <script is:inline>
      try {
        if (!matchMedia('(prefers-reduced-motion: reduce)').matches)
          document.documentElement.classList.add('motion');
      } catch (e) {}
    </script>

    <!-- Open Graph / sharing (the 0.724 and "beats the locals" make strong previews) -->
    <meta property="og:type" content="website" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <Nav />
    <main id="main" class:list={[{ 'is-wide': wide }]}>
      <slot />
    </main>
    <Footer />
    <script>
      import '../scripts/motion.ts';
    </script>
  </body>
</html>
